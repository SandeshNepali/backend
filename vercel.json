{
    "builds": [
        {
            "src": "backend/wsgi.py",
            "use": "@vercel/python"
        },
        {
            "src": "backend/static/**",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "src": "/static/(.*)",
            "dest": "/backend/static/$1"
        },
        {
            "src": "/(.*)",
            "dest": "backend/wsgi.py"
        }
    ]
}